VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-side keys (never use a VITE_ prefix, it would put them in the public bundle).
# The app calls /api/ai and /api/nova-poshta on its own domain: the Vite dev
# server locally, Vercel functions in production.
OPENROUTER_API_KEY=
NOVA_POSHTA_API_KEY=
